# Copy this file to .env for local use. On Vercel, add these as Environment Variables.
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Any Gemini model your key can use (check the model list in Google AI Studio).
GEMINI_MODEL=gemini-3.5-flash-lite
# Optional: models to try, in order, if the main one is busy or retired. Leave empty to disable.
# GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-3.7-flash,gemini-3.6-flash
PORT=3000
# Optional: seconds to wait for one AI answer before trying the next model (in milliseconds).
# GEMINI_TIMEOUT_MS=25000
